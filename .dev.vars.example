RESEND_API_KEY=
APP_BASE_URL=http://localhost:5173
ENCRYPTION_KEY=

# --- Clerk auth (production) ---
CLERK_ISSUER=
CLERK_SECRET_KEY=
# (Optional) Public key PEM from the Clerk dashboard. When set, JWT
# verification is networkless — no JWKS fetch on cold paths.
CLERK_JWT_KEY=
# (Optional) Pin the `azp` claim to your frontend origin for defence in
# depth. Example: https://paper-trail.example.com
CLERK_AUTHORIZED_PARTY=

# --- Clerk dev bypass ---
# Skip Clerk verification entirely. Useful when iterating on backend logic
# without configuring a Clerk instance. Leave unset (or false) to require
# real Clerk-issued tokens.
CLERK_BYPASS=true
CLERK_DEV_USER_ID=user_dev_localhost
CLERK_DEV_EMAIL=dev@localhost.dev
# Clerk publishable key — injected into the Vite frontend build via vite.config.ts
# so .env.local is not needed. Get this from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
