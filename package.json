{
  "name": "paper-trail",
  "description": "A Paper Trail that integrates with Stripe in order to send invoices.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && npx @biomejs/biome check --write ./src",
    "build": "tsc && vite build",
    "dev": "vite dev",
    "test": "vitest run",
    "migrate": "wrangler d1 migrations apply paper-trail-db --local",
    "migrate:remote": "wrangler d1 migrations apply paper-trail-db --remote",
    "deploy": "pnpm run build && wrangler deploy",
    "enc:key": "node ./scripts/generate-encryption-key.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.2",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanitize-filename": "^1.6.4",
    "stripe": "^22.1.1",
    "summit-kit": "^3.5.2",
    "xlsx": "0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vite-plugin": "^1.36.4",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.9.0",
    "knip": "^6.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.1"
  }
}
